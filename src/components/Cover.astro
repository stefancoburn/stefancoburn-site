---
/**
 * Book cover, run through Astro's image pipeline at build time.
 * Source JPEGs live in src/images/covers/{slug}.jpg. Each cover is emitted as
 * AVIF (with WebP fallback) at a few responsive widths, given a content-hashed
 * filename (so it caches forever), and lazy-loaded. If no JPEG exists for the
 * slug, a styled placeholder is rendered instead.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const covers = import.meta.glob<{ default: ImageMetadata }>('../images/covers/*.jpg', { eager: true });

interface Props {
  slug: string;
  title: string;
  author?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  slug,
  title,
  author = '',
  widths = [160, 320],
  sizes = '(max-width:640px) 30vw,(max-width:980px) 22vw,160px',
  loading = 'lazy',
} = Astro.props;

const img = covers[`../images/covers/${slug}.jpg`]?.default;
---
{img ? (
  <Picture
    src={img}
    widths={widths}
    sizes={sizes}
    formats={['avif']}
    fallbackFormat="webp"
    alt={title}
    loading={loading}
    decoding="async"
    quality="mid"
  />
) : (
  <div class="placeholder-cover"><div class="pt">{title}</div><div class="pa">{author}</div></div>
)}
