---
/**
 * Email subscribe box (Buttondown). Works with JavaScript off (plain form POST
 * to Buttondown, which shows its own confirmation page). With JS on, the form
 * submits in the background and the confirmation appears inline instead.
 */
import { BUTTONDOWN_USERNAME } from '../data/site';

interface Props {
  /** What the reader just finished — tweaks the wording */
  kind?: 'essay' | 'note';
}
const { kind = 'essay' } = Astro.props;
const action = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`;
---
<section class="subscribe" aria-labelledby="subscribe-heading">
  <div class="subscribe-text">
    <h2 id="subscribe-heading">Enjoyed this {kind === 'note' ? 'note' : 'essay'}? Get the next one by email.</h2>
    <p>Occasional dispatches when I publish a new essay or book note. No noise, no tracking, unsubscribe in one click.</p>
  </div>
  <form class="subscribe-form" action={action} method="post" data-subscribe>
    <input type="hidden" name="embed" value="1" />
    <input type="hidden" name="tag" value="website" />
    <label class="sr-only" for="subscribe-email">Email address</label>
    <input id="subscribe-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" inputmode="email" />
    <button type="submit">Subscribe</button>
    <p class="subscribe-status" aria-live="polite" hidden></p>
  </form>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-subscribe]')) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.subscribe-status')!;
      const btn = form.querySelector<HTMLButtonElement>('button')!;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        // Buttondown's embed endpoint answers with a redirect; we can't read it
        // cross-origin, but the subscription is created. Then Buttondown emails a
        // confirmation link (double opt-in), so we tell the reader to check their inbox.
        await fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' });
        form.reset();
        btn.textContent = 'Subscribed ✓';
        status.textContent = 'Almost there — check your inbox and click the confirmation link.';
        status.hidden = false;
      } catch {
        // Network hiccup: fall back to a normal form submission (Buttondown's page)
        btn.disabled = false;
        btn.textContent = 'Subscribe';
        form.submit();
      }
    });
  }
</script>
