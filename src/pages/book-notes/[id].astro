---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const bookNotes = await getCollection('book-notes');
  return bookNotes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(note);
const dateStr = new Date(note.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const body = note.body || '';
const words = body.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 250));
---

<BaseLayout title={`${note.data.title} - Stefan Coburn`} description={note.data.description} ogImage={`/og/book-notes/${note.id}.png`} active="book-notes">
  <main class="container">
    <article class="prose">
      <h1>{note.data.title}</h1>
      <p class="meta">{dateStr} &middot; {readingTime} min read</p>
      <Content />
      <p class="back-link"><a href="/book-notes">&larr; All Book Notes</a></p>
    </article>
  </main>
</BaseLayout>
