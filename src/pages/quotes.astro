---
import BaseLayout from '../layouts/BaseLayout.astro';
import { quotes } from '../data/quotes';

---
<BaseLayout title="Quotes — Stefan Coburn" ogImage="/og/quotes.png" active="quotes">
  <main class="container">
    <div class="page-title">
      <div>
        <div class="eyebrow">Words that stuck</div>
        <h1>Quotes<em>.</em></h1>
      </div>
    </div>
    <p class="page-intro">A commonplace book. The sentences I keep returning to — on courage, attention, and what a good life looks like.</p>

    <section class="quote-stack quote-article">
      {quotes.map(q => (
        <div class="q">
          <span class="q-mark">&ldquo;</span>
          <p class={q.small ? 'q-text small' : 'q-text'}>{q.text}</p>
          <div class="q-attr">{q.author}</div>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
